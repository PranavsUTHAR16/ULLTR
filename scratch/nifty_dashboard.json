      "type": "row"
    },
    {
      "datasource": {
        "type": "redis-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 5,
      "options": {
        "footer": {
          "fields": [],
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Strike",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "redis-datasource",
            "uid": "${datasource}"
          },
          "query": "EVAL \"local chain_keys = redis.call(\\\"KEYS\\\", \\\"chain:NIFTY:*\\\")\\nif #chain_keys == 0 then return {} end\\ntable.sort(chain_keys)\\nlocal chain_key = chain_keys[1]\\nlocal fields = redis.call(\\\"HKEYS\\\", chain_key)\\nlocal res = {}\\nfor _, f in ipairs(fields) do\\n    local strike, otype = f:match(\\\"^(%d+):(%a+)$\\\"\\n    if strike and otype then\\n        local symbol = redis.call(\\\"HGET\\\", chain_key, f)\\n        if symbol then\\n            local ltp = redis.call(\\\"HGET\\\", \\\"md:quote:\\\" .. symbol, \\\"ltp\\\")\\n            local iv = redis.call(\\\"HGET\\\", \\\"md:quote:\\\" .. symbol, \\\"iv\\\")\\n            local delta = redis.call(\\\"HGET\\\", \\\"md:quote:\\\" .. symbol, \\\"delta\\\")\\n            table.insert(res, {tonumber(strike), otype, symbol, tonumber(ltp) or 0, tonumber(iv) or 0, tonumber(delta) or 0})\\n        end\\n    end\\nend\\ntable.sort(res, function(a, b)\\n    if a[1] == b[1] then\\n        return a[2] < b[2]\\n    else\\n        return a[1] < b[1]\\n    end\\nend)\\nreturn res\" 0",
          "refId": "A",
          "type": "cli"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "Field 1": "Strike",
              "Field 2": "Type",
              "Field 3": "Symbol",
              "Field 4": "LTP",
              "Field 5": "IV",
              "Field 6": "Delta"
            }
          }
        }
      ],
      "title": "Live Option Chain (Front Expiry)",
      "type": "table"
    }

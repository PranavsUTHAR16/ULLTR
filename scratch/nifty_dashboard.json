      "targets": [
        {
          "datasource": {
            "type": "redis-datasource",
            "uid": "${datasource}"
          },
          "query": "EVAL \"local key = \\\"md:candles:NSE_INDEX|Nifty 50:15m\\\"\\nlocal ts_list = redis.call(\\\"ZRANGE\\\", key, -60, -1)\\nlocal res = {}\\nfor i, ts in ipairs(ts_list) do\\n    local close = redis.call(\\\"HGET\\\", \\\"md:candle:NSE_INDEX|Nifty 50:15m:\\\" .. ts, \\\"close\\\")\\n    if close then\\n        table.insert(res, {tonumber(ts) * 1000, tonumber(close)})\\n    end\\nend\\nreturn res\" 0",
          "refId": "A",
          "type": "cli"
        }
      ],
      "title": "Nifty Spot 15m Close Price (Last 60 bars)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 15
